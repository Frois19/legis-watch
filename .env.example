DATABASE_URL="file:./dev.db"
LEGISLATURA_ATUAL=57
CAMARA_API_BASE=https://dadosabertos.camara.leg.br/api/v2
CAMARA_ARQUIVOS_BASE=https://dadosabertos.camara.leg.br/arquivos
CAMARA_REQUEST_DELAY_MS=600
CAMARA_MAX_RETRIES=3
CAMARA_CONNECT_TIMEOUT_MS=60000
CAMARA_BODY_TIMEOUT_MS=120000
# SKIP_DEPUTY_DETAIL=1
# DEPUTY_DETAIL_LIMIT=5
# PROPOSITION_TYPES=PL,PEC,PLP,PDC,PLV,PRC
# PROPOSITION_MAX_PAGES=2
# PROPOSITION_ENRICH_AUTHORS=1
# SYNC_SECRET=change-me
# Cache da busca de deputados (memória / instância)
# SEARCH_CACHE_TTL_MS=120000
# SEARCH_CACHE_MAX=500
# ALEPE (piloto estadual PE) — fallback automático para fixture se a API falhar
# ALEPE_API_BASE=https://dadosabertos.alepe.pe.gov.br/api/v1/parlamentares/?formato=json
# ALEPE_TIMEOUT_MS=15000
# ALEPE_REQUIRE_LIVE=1
# ALMG (MG) — cadastro + filiações/mandatos; proposições via CSV anual
# ALMG_API_BASE=https://dadosabertos.almg.gov.br/api/v2
# ALMG_CSV_BASE=https://dadosabertos.almg.gov.br/arquivo
# ALMG_PROP_YEARS=2026,2025
# ALMG_CSV_TTL_MS=21600000
# ALMG_TIMEOUT_MS=45000
# ALMG_REQUIRE_LIVE=1
# ALESP (SP) — cadastro via deputados.xml
# ALESP_DEPUTADOS_URL=https://www.al.sp.gov.br/repositorioDados/deputados/deputados.xml
# ALESP_TIMEOUT_MS=30000
# ALESP_REQUIRE_LIVE=1
# SAPL multi-UF (AC/AL/AM/PB/PI/RO/TO)
# SAPL_TIMEOUT_MS=20000
# SAPL_REQUIRE_LIVE=1
# ESTADUAL_MATTER_LIMIT=60
# ESTADUAL_PROFILE_TTL_MS=86400000
# Senado Federal — lista atual; fallback para fixture se a API falhar
# SENADO_API_ROOT=https://legis.senado.leg.br/dadosabertos
# SENADO_API_BASE=https://legis.senado.leg.br/dadosabertos/senador/lista/atual.json
# SENADO_TIMEOUT_MS=20000
# SENADO_REQUIRE_LIVE=1
# SENADO_MATTER_LIMIT=80
# SENADO_VOTE_LIMIT=100
# SENADO_PROFILE_TTL_MS=86400000


DATABASE_URL="file:./dev.db"
LEGISLATURA_ATUAL=57
CAMARA_API_BASE=https://dadosabertos.camara.leg.br/api/v2
CAMARA_ARQUIVOS_BASE=https://dadosabertos.camara.leg.br/arquivos
CAMARA_REQUEST_DELAY_MS=600
CAMARA_MAX_RETRIES=3
CAMARA_CONNECT_TIMEOUT_MS=60000
CAMARA_BODY_TIMEOUT_MS=120000

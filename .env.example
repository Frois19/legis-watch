# DEPUTY_DETAIL_LIMIT=5
# PROPOSITION_TYPES=PL,PEC,PLP,PDC,PLV,PRC
# PROPOSITION_MAX_PAGES=2
# PROPOSITION_ENRICH_AUTHORS=1
# SYNC_SECRET=change-me
# Cache da busca de deputados (memória / instância)
# SEARCH_CACHE_TTL_MS=120000
# SEARCH_CACHE_MAX=500
# ALEPE (piloto estadual PE) — fallback automático para fixture se a API falhar
# ALEPE_API_BASE=https://dadosabertos.alepe.pe.gov.br/api/v1/parlamentares/?formato=json
# ALEPE_PROP_BASE=https://dadosabertos.alepe.pe.gov.br/api/v1/proposicoes
# ALEPE_PROP_YEARS=2026,2025
# ALEPE_TIMEOUT_MS=20000
# ALEPE_REQUIRE_LIVE=1
# ALMG (MG) — cadastro + filiações/mandatos; proposições via CSV anual
# ALMG_API_BASE=https://dadosabertos.almg.gov.br/api/v2
# ALMG_CSV_BASE=https://dadosabertos.almg.gov.br/arquivo
# ALMG_PROP_YEARS=2026,2025
# ALMG_CSV_TTL_MS=21600000
# ALMG_TIMEOUT_MS=45000
# ALMG_REQUIRE_LIVE=1
# ALESP (SP) — cadastro + proposições (XML/ZIP com cache em .cache/parliament)
# ALESP_DEPUTADOS_URL=https://www.al.sp.gov.br/repositorioDados/deputados/deputados.xml
# ALESP_PROPOSITURAS_URL=https://www.al.sp.gov.br/repositorioDados/processo_legislativo/proposituras.zip
# ALESP_AUTORES_URL=https://www.al.sp.gov.br/repositorioDados/processo_legislativo/documento_autor.zip
# ALESP_NATUREZAS_URL=https://www.al.sp.gov.br/repositorioDados/processo_legislativo/naturezasSpl.xml
# ALESP_PROP_YEARS=2026,2025
# ALESP_CACHE_TTL_MS=43200000
# ALESP_TIMEOUT_MS=120000
# ALESP_REQUIRE_LIVE=1
# ALEP (PR) — cadastro (remuneração) + proposições (POST filtrar)
# ALEP_WS_BASE=http://webservices.assembleia.pr.leg.br/api/public
# ALEP_TRANSPARENCIA_BASE=https://transparencia.assembleia.pr.leg.br/api
# ALEP_PROP_YEARS=2026,2025
# ALEP_CACHE_TTL_MS=21600000
# ALEP_TIMEOUT_MS=30000
# ALEP_REQUIRE_LIVE=1
# Cache HTTP unificado (assembleias + Senado) — memória + disco
# PARLIAMENT_CACHE_DIR=.cache/parliament
# HTTP_CACHE_TTL_MS=21600000
# HTTP_CACHE_MAX=400
# HTTP_CACHE_DISK=1
# ALEPE_CACHE_TTL_MS=21600000
